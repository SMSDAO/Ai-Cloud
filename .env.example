# Ai-Cloud — Environment Configuration Template
# Copy this file to .env and fill in the values.
# See docs/guide.md for full configuration reference.

# ── Server ──────────────────────────────────────────────────────────────────
# Bind address (default: 0.0.0.0)
# BIND_ADDR=0.0.0.0

# Port to listen on (default: 8080)
PORT=8080

# External host for generating links
# CS_DISABLE_PROXY=false

# ── Authentication ───────────────────────────────────────────────────────────
# Plain-text password (hashed before storage — not recommended for production)
# PASSWORD=your-secret-password

# SHA-256 hashed password (recommended)
# Run: echo -n 'yourpassword' | sha256sum
# HASHED_PASSWORD=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855

# Auth mode: password | none
# CS_AUTH=password

# Cookie session name suffix (to avoid collisions with multiple instances)
# COOKIE_SUFFIX=

# ── TLS ──────────────────────────────────────────────────────────────────────
# Path to TLS certificate file
# CERT=/path/to/cert.pem

# Path to TLS key file
# CERT_KEY=/path/to/key.pem

# ── User Data ────────────────────────────────────────────────────────────────
# Directory to store user data (settings, extensions, etc.)
# USER_DATA_DIR=~/.local/share/code-server

# ── Extensions ───────────────────────────────────────────────────────────────
# Additional extensions directory
# EXTENSIONS_DIR=

# Disable automatic extension updates
# DISABLE_UPDATE_CHECK=false

# ── Proxy ────────────────────────────────────────────────────────────────────
# HTTP proxy settings (inherits from environment)
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=

# ── Logging ──────────────────────────────────────────────────────────────────
# Log level: trace | debug | info | warn | error
# LOG_LEVEL=info

# ── Observability ────────────────────────────────────────────────────────────
# Health check endpoint is always enabled at /healthz
# HEALTHZ_PATH=/healthz

# ── Node.js ──────────────────────────────────────────────────────────────────
NODE_ENV=production
